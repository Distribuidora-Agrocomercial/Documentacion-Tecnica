# Copiar a variables de entorno del proyecto en Vercel (Project Settings → Environment Variables).
# Nunca commitear un archivo .env real con valores.

# Token de GitHub (fine-grained, con acceso SOLO a este repo, permiso "Contents: Read and write").
# Se usa exclusivamente en el servidor (funciones /api) para leer/escribir catalogo.json y archivos.
GITHUB_TOKEN=

GITHUB_OWNER=FelixOb1990
GITHUB_REPO=Docuentacion-Tecnica
GITHUB_BRANCH=main

# Contraseña del panel de administración (elegí una fuerte). Se compara en el servidor,
# nunca se expone al navegador.
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión del panel. Generar con: openssl rand -hex 32
SESSION_SECRET=

# Se agrega automáticamente al conectar un Blob Store en el proyecto de Vercel (Storage → Blob).
# No hace falta configurarlo a mano en producción.
BLOB_READ_WRITE_TOKEN=
